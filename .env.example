# Copy this file to .env and fill in your values
# .env is gitignored — never commit real secrets

# Security — generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=[SECRET_HERE]
JWT_ALGORITHM=HS256
JWT_EXPIRE_DAYS=7

# Database — swap to postgresql://user:pass@host/dbname for cloud deploy
DATABASE_URL=sqlite:///./data/budget.db

# CORS — comma-separated list of allowed origins
# For LAN access add your local IP, e.g. http://192.168.1.10:5173
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Base URL used to build links in emails (e.g. password reset).
# Leave unset to reuse the first ALLOWED_ORIGINS entry.
# FRONTEND_URL=http://192.168.1.10:5173

# Server
HOST=0.0.0.0
PORT=8000

# Email / Daily Summary (optional — leave blank to disable)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@gmail.com
# SMTP_PASS=your-app-password
# SMTP_FROM=OfflineBudget <you@gmail.com>
# DAILY_SUMMARY_HOUR=7   # 0-23, local server time

# Weekly Digest (optional — appends spending-by-category/top-merchants/balance-risk to the
# Daily Summary on WEEKLY_DIGEST_DAY. Set DIGEST_RECIPIENTS to anything non-blank to enable it;
# the value itself is no longer used for delivery -- the digest goes out to the same recipients
# as the Daily Summary. Leave blank to disable.)
# WEEKLY_DIGEST_DAY=fri        # APScheduler day_of_week: mon,tue,wed,thu,fri,sat,sun
# DIGEST_RECIPIENTS=enabled

# Secrets at rest — encrypts the SimpleFIN bank token AND the SMTP password
# saved from Settings → Notifications & Email. Without it the app refuses to
# store the SMTP password at all rather than writing it in plaintext.
# Generate with: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# APP_ENCRYPTION_KEY=[FERNET_KEY_HERE]
# Legacy name, still honoured if APP_ENCRYPTION_KEY is unset:
# BANK_TOKEN_ENCRYPTION_KEY=[FERNET_KEY_HERE]

# NOTE: everything below the Email section is now also editable at
# Settings → Notifications & Email, which overrides these at runtime.
# The values above (JWT, DATABASE_URL, CORS, HOST/PORT, encryption key) are
# deliberately env-only — see backend/services/app_settings.py for why.
