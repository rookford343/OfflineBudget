# Copy this file to .env and fill in your values
# .env is gitignored — never commit real secrets

# Security — generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=[SECRET_HERE]
JWT_ALGORITHM=HS256
JWT_EXPIRE_DAYS=7

# Database — swap to postgresql://user:pass@host/dbname for cloud deploy
DATABASE_URL=sqlite:///./data/budget.db

# CORS — comma-separated list of allowed origins
# For LAN access add your local IP, e.g. http://192.168.1.10:5173
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Server
HOST=0.0.0.0
PORT=8000
