#!/bin/sh
# Blocks a push if the backend test suite doesn't pass.
#
# Catches regressions before they leave the machine -- the forecast_engine.py
# date-anchoring bug (2026-09-02) silently distorted Left to Spend/Safety
# Margin for the better part of a week with nothing to catch it, because the
# regression tests that would have caught it didn't exist yet AND nothing
# forced the suite to run before code shipped. This is the second half of
# that fix: the tests alone don't help if nobody has to run them.
#
# It also checks uv.lock against pyproject.toml, audits the locked
# dependencies for known vulnerabilities, re-runs the commit-time lint over the
# whole tree (a commit can skip its hook), runs the same CodeQL analysis as
# GitHub code scanning (scripts/codeql_scan.sh), imports the app (an "unused import" autofix once broke a router
# that imported through another module), and enforces the coverage floor in
# backend/.coveragerc.
#
# It then does the frontend's equivalent of the lockfile/audit checks above:
# installs frontend/ exactly from bun.lock, audits it for known high/critical
# vulnerabilities, and confirms the production bundle still builds. This
# followed Dependabot flagging 65 unaudited frontend vulnerabilities (33
# high) with nothing gating them before a push (2026-10-27). It does not run
# `tsc -b` -- 35 pre-existing TypeScript errors in unrelated files are known
# debt tracked separately, and gating the build on them would block
# unrelated pushes.
repo_root=$(git rev-parse --show-toplevel) || exit 1
cd "$repo_root" || exit 1

echo "Lockfile matches pyproject.toml..."
if ! uv lock --check; then
  echo "BLOCKED: uv.lock is out of date. Run: uv lock" >&2
  exit 1
fi

echo "Dependency audit (known vulnerabilities, abandoned packages)..."
if ! uv audit --preview-features audit; then
  echo "BLOCKED: a locked dependency has a known vulnerability or is abandoned. Upgrade or replace it." >&2
  exit 1
fi

echo "Lint (ruff: security + bugs)..."
if ! uv run --locked ruff check .; then
  echo "BLOCKED: ruff findings. Fix them before pushing." >&2
  exit 1
fi

echo "Import check..."
if ! uv run --locked python -c "import backend.main, cli.budget"; then
  echo "BLOCKED: the app no longer imports." >&2
  exit 1
fi

echo "CodeQL (same analysis as GitHub code scanning, ~1 min)..."
if ! sh "$repo_root/scripts/codeql_scan.sh"; then
  echo "BLOCKED: CodeQL findings (or CodeQL missing: brew install --cask codeql)." >&2
  exit 1
fi

echo "Backend tests with coverage floor..."
cd "$repo_root/backend" || exit 1
if ! uv run --locked python -m pytest -q --cov --cov-report=term:skip-covered; then
  echo "" >&2
  echo "BLOCKED: tests failing or coverage under the floor in backend/.coveragerc. Push with --no-verify only if you're sure." >&2
  exit 1
fi

echo "Frontend: installing from bun.lock..."
cd "$repo_root/frontend" || exit 1
if ! bun install --frozen-lockfile; then
  echo "BLOCKED: frontend/bun.lock is out of date with package.json. Run: bun install" >&2
  exit 1
fi

echo "Frontend dependency audit (known vulnerabilities)..."
if ! bun audit --audit-level=high; then
  echo "BLOCKED: a locked frontend dependency has a known high/critical vulnerability. Upgrade or override it." >&2
  exit 1
fi

echo "Frontend production build..."
if ! bunx vite build; then
  echo "BLOCKED: the frontend production build failed." >&2
  exit 1
fi
exit 0
