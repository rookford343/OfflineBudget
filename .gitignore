# Database backups — contain REAL financial data and encrypted bank tokens.
# data/*.db does NOT match these (a gitignore * never crosses /), so without
# this line `git add -A` would publish them. This repo is PUBLIC.
data/backups/
data/*.db-*
data/.DS_Store

# Stray SQLite artifacts from a misconfigured run (April 2026): the app was
# briefly started with the frontend as cwd, creating an empty second DB here.
frontend/data/

# Superpowers scratch workspaces
.superpowers/

# Retired v1 prototype (removed 2026-08-14). Recoverable from git history.
old_version/

# --- Bank data: spelling-proof ---------------------------------------------
# A real leak happened because the folder was created as "transaction_flies"
# while this file said "transaction_files", so the ignore never matched and
# 735 real transactions went to a PUBLIC repo (purged 2026-08-14). Match on
# the FILE TYPE anywhere under data/, not on one exact folder name.
data/**/*.csv
data/**/*.CSV
data/**/*.xlsx
data/**/*.xls
data/**/*.ofx
data/**/*.qfx
data/**/*.db
data/**/*.sqlite*
